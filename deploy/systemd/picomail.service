[Unit]
Description=picomail inbound SMTP archive
After=network-online.target
Wants=network-online.target
Requires=picomail.socket

[Service]
Type=simple
User=picomail
Group=picomail
ExecStart=/usr/local/bin/picomaild
EnvironmentFile=/etc/picomail/picomail.env
Restart=on-failure
RestartSec=2
StateDirectory=picomail
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# picomail is receive-only: it accepts the activated socket but never connects out.
SystemCallFilter=~connect
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
