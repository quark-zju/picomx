# Replace these values before starting picomail.socket.
PICOMAIL_HOSTNAME=mx.mail.example
PICOMAIL_DOMAINS=mail.example

# The systemd unit creates /var/lib/picomail with mode 0700.
PICOMAIL_ARCHIVE_ROOT=/var/lib/picomail/messages

# Strongly recommended for public SMTP. The picomail user must be able to read
# the certificate and key.
PICOMAIL_TLS_CERT=/etc/picomail/tls/fullchain.pem
PICOMAIL_TLS_KEY=/etc/picomail/tls/privkey.pem
