# Replace these values before starting picomx.socket.
PICOMX_HOSTNAME=mx.mail.example
PICOMX_DOMAINS=mail.example

# The systemd unit creates /var/lib/picomx with mode 0700.
# picomx initializes a bare Git repo here; received and deleted mail remains in history.
PICOMX_ARCHIVE_ROOT=/var/lib/picomx/messages

# UTC daily receipt budget, saved in <archive-root>.rate-limit.json outside Git.
# Tiny messages cost at least 4 KiB.
PICOMX_MAX_DAILY_BYTES=52428800

# Coordinated foreground GC; also requested after 256 commits.
PICOMX_GIT_MAINTENANCE_INTERVAL=6h

# The same certificate serves SMTP STARTTLS and POP3S. picomx searches the
# exact and parent hostname directories for fullchain.pem and privkey.pem.
PICOMX_CERT_DIR=/etc/picosrv/certs
PICOMX_POP3_HOSTNAME=mx.mail.example
PICOMX_TLS_HOSTNAMES=mx.mail.example

# make deploy appends PICOMX_POP3_USERNAME and PICOMX_POP3_PASSWORD_SHA256
# when it creates the real env file. Missing either value denies every login.
